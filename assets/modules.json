{
    "$comment": "The parts of mypgs a project picks with the include of mypgs.config.json. scss: the file index.scss loads for it; js: the file under assets/javascript/modules/ that imports and registers it; requires: what it needs to work, added when the part is included (markup its JavaScript builds, or rules it builds on). The base, the patterns (color, border, typography, general) and the layout utilities (section, flex, grid, flexGrid, breakpoints, utilities, spacing, size) are always loaded: everything else is built on them.",
    "modules": {
        "accordion": { "scss": "components/accordion", "js": "accordion" },
        "alerts": { "scss": "components/alerts", "js": "alerts", "requires": ["button", "icon"] },
        "badges": { "scss": "components/badges" },
        "breadcrumb": { "scss": "components/breadcrumb" },
        "button": { "scss": "components/button" },
        "card": { "scss": "components/card" },
        "dropdown": { "scss": "components/dropdown", "js": "dropdown" },
        "form": { "scss": "components/form" },
        "formAddon": { "scss": "components/formAddon", "js": "formAddon", "requires": ["form", "listbox"] },
        "formControls": { "scss": "components/formControls", "js": "formControls", "requires": ["form"] },
        "formValidate": { "js": "formValidate", "requires": ["alerts", "toast"] },
        "icon": { "scss": "components/icon" },
        "listbox": { "scss": "components/listbox" },
        "logo": { "scss": "components/logo" },
        "menu": { "scss": "components/menu", "js": "menu", "requires": ["dropdown", "button", "icon"] },
        "modal": { "scss": "components/modal", "js": "modal", "requires": ["button", "icon"] },
        "notification": { "scss": "components/notification", "js": "notification", "requires": ["alerts", "modal", "button"] },
        "pageNav": { "scss": "components/pageNav", "js": "pageNav" },
        "search": { "scss": "components/search", "js": "search", "requires": ["icon", "listbox"] },
        "slides": { "scss": "components/slides", "js": "slides", "requires": ["button", "icon"] },
        "steps": { "scss": "components/steps", "js": "steps" },
        "stepTabs": { "scss": "components/stepTabs", "js": "stepTabs", "requires": ["button", "icon"] },
        "summary": { "scss": "components/summary", "js": "summary" },
        "table": { "scss": "components/table" },
        "tabs": { "scss": "components/tabs", "js": "tabs" },
        "toast": { "scss": "components/toast", "js": "toast", "requires": ["alerts"] },
        "pageShell": { "scss": "layout/pageShell" },
        "header": { "scss": "layout/header", "js": "header" },
        "navSmart": { "scss": "layout/navSmart", "js": "navSmart" },
        "footer": { "scss": "layout/footer" }
    }
}
