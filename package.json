{
    "name": "mypgs",
    "version": "4.7.1",
    "description": "MyPGS frontend theme and UI behaviors, with bundled JavaScript and CSS assets.",
    "main": "./dist/javascript/index.js",
    "module": "./assets/javascript/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./assets/javascript/index.js",
            "default": "./dist/javascript/index.js"
        },
        "./style.css": "./dist/css/index.css",
        "./style.min.css": "./dist/css/index.min.css",
        "./vite-plugin-pgs": {
            "types": "./plugins/vite-plugin-pgs.d.ts",
            "import": "./plugins/vite-plugin-pgs.js",
            "default": "./plugins/vite-plugin-pgs.js"
        }
    },
    "style": "./dist/css/index.css",
    "scripts": {
        "docs:generate": "node scripts/generate-component-docs.js",
        "icons:sync": "node scripts/sync-icons.js",
        "start": "webpack",
        "start watch": "webpack --watch",
        "syncmaster": "git fetch origin && git checkout master && git pull --ff-only origin master && git merge --no-edit origin/dev && git push origin master && git checkout dev",
        "syncmaster commit": "printf 'Merge message: ' && IFS= read -r merge_message && test -n \"$merge_message\" && git fetch origin && git checkout master && git pull --ff-only origin master && git merge --no-ff origin/dev -m \"$merge_message\" && git push origin master && git checkout dev"
    },
    "keywords": [
        "theme",
        "css",
        "ui",
        "frontend",
        "components"
    ],
    "license": "ISC",
    "devDependencies": {
        "css-loader": "^7.1.2",
        "mini-css-extract-plugin": "^2.9.2",
        "postcss-loader": "^8.2.0",
        "sass": "^1.86.3",
        "sass-loader": "^16.0.5",
        "sass-migrator": "^2.3.1",
        "style-loader": "^4.0.0",
        "webpack": "^5.98.0",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.0",
        "webpack-remove-empty-scripts": "^1.0.4"
    }
}
